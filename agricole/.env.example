# Copier ce fichier en .env dans ce répertoire (agricole/) et renseigner de
# vraies valeurs avant de lancer `docker compose up -d --build`. Ne jamais
# committer .env.

# Secret de signature des sessions JWT (chaîne aléatoire longue)
JWT_SECRET=

# Identifiants du premier compte administrateur créé au premier démarrage
SEED_ADMIN_EMAIL=admin@elections-agricole.fr
SEED_ADMIN_PASSWORD=

# Clé de chiffrement au repos (chaîne aléatoire longue) pour la clé API
# Brevo stockée en base. À défaut, JWT_SECRET est réutilisé.
SECRET_KEY=

# Clé API Brevo utilisée pour les e-mails système (réinitialisation de mot
# de passe), indépendante de la clé Brevo des campagnes de relance (onglet
# "Relances adhérents"). Sans elle, le lien "mot de passe oublié" ne peut
# envoyer aucun e-mail.
SYSTEM_EMAIL_BREVO_API_KEY=

# Adresse publique du serveur (sans slash final), utilisée pour construire
# les URL absolues des images des mails de relance (logo, réseaux sociaux)
# et le lien de réinitialisation de mot de passe envoyé par e-mail.
# Exemple : http://163.172.15.114:8081 (ou https://agricole.votre-domaine.fr
# une fois le sous-domaine configuré).
PUBLIC_BASE_URL=

# Port hôte exposé par le frontend, laisser vide pour 8081 (par défaut).
FRONTEND_PORT=
