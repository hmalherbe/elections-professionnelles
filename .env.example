# Copier ce fichier en .env sur le serveur et renseigner de vraies valeurs
# avant de lancer `docker compose up -d --build`. Ne jamais committer .env.

# Secret de signature des sessions JWT (chaîne aléatoire longue)
JWT_SECRET=

# Identifiants du compte admin général créé au premier démarrage
SEED_ADMIN_EMAIL=admin@elections-pro.fr
SEED_ADMIN_PASSWORD=

# Clé de chiffrement des mots de passe des portails de scraping (chaîne
# aléatoire longue). À défaut, JWT_SECRET est réutilisé.
SCRAPING_SECRET_KEY=

# Identifiants du faux portail de connexion (service mock-portal), utilisé
# uniquement pour tester le scraping avant l'ouverture des vrais portails.
MOCK_PORTAL_USERNAME=demo
MOCK_PORTAL_PASSWORD=

# Clé API Brevo utilisée pour les e-mails système (réinitialisation de mot
# de passe), indépendante des clés Brevo personnelles de chaque admin.
# Sans elle, le lien "mot de passe oublié" ne peut envoyer aucun e-mail.
SYSTEM_EMAIL_BREVO_API_KEY=

# Adresse publique du serveur (sans slash final), utilisée pour construire
# les URL absolues des images des mails de relance (logos réseaux sociaux) —
# une image en data URI est bloquée par de nombreux clients mail (Gmail,
# Outlook.com...), il faut donc une vraie URL joignable depuis Internet —
# ainsi que le lien de réinitialisation de mot de passe envoyé par e-mail.
# Exemple : http://163.172.15.114 (ou https://votre-domaine.fr une fois configuré).
PUBLIC_BASE_URL=http://163.172.15.114
